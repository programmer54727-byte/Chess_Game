rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(val) {
      return val is timestamp && val <= request.time;
    }

    // --- User Profile Validator ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 &&
             data.displayName is string && data.displayName.size() > 0 &&
             data.rating is int && data.rating >= 100 &&
             (!('gamesPlayed' in data) || data.gamesPlayed is int) &&
             (!('wins' in data) || data.wins is int) &&
             (!('losses' in data) || data.losses is int) &&
             (!('draws' in data) || data.draws is int) &&
             (!('puzzlesSolved' in data) || data.puzzlesSolved is int) &&
             (!('dailyStreak' in data) || data.dailyStreak is int) &&
             (!('lastDailyPuzzleDate' in data) || data.lastDailyPuzzleDate is string) &&
             (!('bio' in data) || data.bio is string) &&
             (!('achievements' in data) || data.achievements is list) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    // --- Matchmaking Queue Validator ---
    function isValidQueueEntry(data) {
      return data.userId is string && data.userId.size() > 0 &&
             data.displayName is string && data.displayName.size() > 0 &&
             data.rating is int &&
             data.status in ['waiting', 'matched', 'cancelled'] &&
             (!('gameId' in data) || data.gameId is string) &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    // --- Chess Game Validator ---
    function isValidChessGame(data) {
      return data.gameId is string && data.gameId.size() > 0 &&
             data.whitePlayerId is string && data.whitePlayerId.size() > 0 &&
             data.blackPlayerId is string && data.blackPlayerId.size() > 0 &&
             data.fen is string && data.fen.size() > 0 &&
             data.currentTurn in ['white', 'black'] &&
             data.status in ['in_progress', 'white_won', 'black_won', 'draw'] &&
             (!('moves' in data) || data.moves is list) &&
             (!('pgn' in data) || data.pgn is string) &&
             (!('statusReason' in data) || data.statusReason is string) &&
             (!('winnerId' in data) || data.winnerId is string) &&
             (!('isRanked' in data) || data.isRanked is bool) &&
             (!('whiteRatingChange' in data) || data.whiteRatingChange is int) &&
             (!('blackRatingChange' in data) || data.blackRatingChange is int) &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    // --- Game Message Validator ---
    function isValidGameMessage(data) {
      return data.messageId is string && data.messageId.size() > 0 &&
             data.senderId is string && data.senderId.size() > 0 &&
             data.senderName is string && data.senderName.size() > 0 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 500 &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    // --- Community Post Validator ---
    function isValidCommunityPost(data) {
      return data.postId is string && data.postId.size() > 0 &&
             data.authorId is string && data.authorId.size() > 0 &&
             data.authorName is string && data.authorName.size() > 0 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 3000 &&
             (!('authorRating' in data) || data.authorRating is int) &&
             (!('likesCount' in data) || data.likesCount is int) &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    // --- Direct Message Validator ---
    function isValidDirectMessage(data) {
      return data.messageId is string && data.messageId.size() > 0 &&
             data.senderId is string && data.senderId.size() > 0 &&
             data.senderName is string && data.senderName.size() > 0 &&
             data.receiverId is string && data.receiverId.size() > 0 &&
             data.participants is list && data.participants.size() == 2 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 1000 &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    // --- Collection Rules ---

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow delete: if false;
    }

    // Matchmaking Queue
    match /matchmaking_queue/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && isValidQueueEntry(request.resource.data);
      allow update: if isAuthenticated() && isValidQueueEntry(request.resource.data);
      allow delete: if isOwner(userId);
    }

    // Games
    match /games/{gameId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    (request.auth.uid == request.resource.data.whitePlayerId || request.auth.uid == request.resource.data.blackPlayerId) &&
                    isValidChessGame(request.resource.data);
      allow update: if isAuthenticated() &&
                    (request.auth.uid == resource.data.whitePlayerId || request.auth.uid == resource.data.blackPlayerId) &&
                    isValidChessGame(request.resource.data);
      allow delete: if false;

      // In-game messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
                      request.auth.uid == request.resource.data.senderId &&
                      isValidGameMessage(request.resource.data);
        allow update, delete: if false;
      }
    }

    // Public Community Posts
    match /community_posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                    request.auth.uid == request.resource.data.authorId &&
                    isValidCommunityPost(request.resource.data);
      allow update: if isAuthenticated() &&
                    (request.auth.uid == resource.data.authorId || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])) &&
                    isValidCommunityPost(request.resource.data);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.authorId;
    }

    // Direct Messages
    match /direct_messages/{messageId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() &&
                    request.auth.uid == request.resource.data.senderId &&
                    (request.auth.uid in request.resource.data.participants) &&
                    isValidDirectMessage(request.resource.data);
      allow update: if false;
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.senderId;
    }
  }
}
